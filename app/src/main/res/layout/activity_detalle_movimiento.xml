<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/smartcash_fondo"
    android:orientation="vertical"
    tools:context=".DetalleMovimientoActivity">

    <!-- Barra superior reutilizable -->
    <include layout="@layout/view_barra_superior" />

    <!-- Contenido de la pantalla -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Información principal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="28dp">

                <!-- Icono de la categoría -->
                <ImageView
                    android:id="@+id/imgDetalleCategoria"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_icono"
                    android:contentDescription="@string/detalle_icono"
                    android:padding="16dp"
                    android:src="@drawable/ic_comida" />

                <!-- Nombre del movimiento -->
                <TextView
                    android:id="@+id/txtDetalleNombre"
                    style="@style/Estilo.Subtitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    tools:text="Supermercado" />

                <!-- Monto del movimiento -->
                <TextView
                    android:id="@+id/txtDetalleMonto"
                    style="@style/Estilo.Saldo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/smartcash_gasto"
                    tools:text="-₡45 000" />

            </LinearLayout>

            <!-- Separador -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/smartcash_divisor" />

            <!-- Tipo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Estilo.Secundario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/detalle_tipo" />

                <TextView
                    android:id="@+id/txtDetalleTipo"
                    style="@style/Estilo.Cuerpo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Gasto" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/smartcash_divisor" />

            <!-- Categoría -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Estilo.Secundario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/detalle_categoria" />

                <TextView
                    android:id="@+id/txtDetalleCategoria"
                    style="@style/Estilo.Cuerpo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Comida" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/smartcash_divisor" />

            <!-- Fecha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Estilo.Secundario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/detalle_fecha" />

                <TextView
                    android:id="@+id/txtDetalleFecha"
                    style="@style/Estilo.Cuerpo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="11/10/2026" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/smartcash_divisor" />

            <!-- Nota -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    style="@style/Estilo.Secundario"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="@string/detalle_nota" />

                <TextView
                    android:id="@+id/txtDetalleNota"
                    style="@style/Estilo.Cuerpo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    tools:text="Compra de supermercado" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/smartcash_divisor" />

            <!-- Comprobante -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    style="@style/Estilo.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Comprobante fotográfico"
                    android:layout_marginBottom="16dp"/>

                <!-- Contenedor cuando hay imagen -->
                <LinearLayout
                    android:id="@+id/layoutComprobanteImagen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/imgComprobanteMiniatura"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="Miniatura del comprobante"
                        android:background="@color/smartcash_divisor"/>

                    <Button
                        android:id="@+id/btnVerComprobante"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ver comprobante" />
                </LinearLayout>

                <!-- Mensaje cuando no hay imagen -->
                <TextView
                    android:id="@+id/txtSinComprobante"
                    style="@style/Estilo.Cuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin comprobante"
                    android:gravity="center"
                    android:padding="24dp"
                    android:drawableTop="@drawable/ic_comprobante"
                    android:drawablePadding="8dp"
                    android:visibility="gone"
                    tools:visibility="visible"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Botones inferiores -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- Editar movimiento -->
        <Button
            android:id="@+id/btnEditarMovimiento"
            style="@style/Estilo.Boton.Primario"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="@string/detalle_editar" />

        <!-- Eliminar movimiento -->
        <Button
            android:id="@+id/btnEliminarMovimiento"
            style="@style/Estilo.Boton.Peligro"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:text="@string/detalle_eliminar" />

    </LinearLayout>

</LinearLayout>