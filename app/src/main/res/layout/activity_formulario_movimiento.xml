<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/smartcash_fondo"
    android:orientation="vertical"
    tools:context=".FormularioMovimientoActivity">

    <include layout="@layout/view_barra_superior" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGasto"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:text="@string/formulario_gasto"
                    android:textColor="@color/smartcash_gasto"
                    android:backgroundTint="@color/smartcash_gasto_fondo" />

                <Button
                    android:id="@+id/btnIngreso"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/formulario_ingreso"
                    android:textColor="@color/smartcash_ingreso"
                    android:backgroundTint="@color/smartcash_ingreso_fondo" />

            </LinearLayout>

            <TextView
                style="@style/Estilo.Etiqueta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/formulario_nombre" />

            <EditText
                android:id="@+id/etNombre"
                style="@style/Estilo.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/formulario_nombre_hint"
                android:enabled="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:inputType="textCapSentences" />

            <TextView
                style="@style/Estilo.Etiqueta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/formulario_monto" />

            <EditText
                android:id="@+id/etMonto"
                style="@style/Estilo.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/formulario_monto_hint"
                android:enabled="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:inputType="numberDecimal" />

            <TextView
                style="@style/Estilo.Etiqueta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/formulario_categoria" />

            <Spinner
                android:id="@+id/spCategoria"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_campo"
                android:enabled="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                style="@style/Estilo.Etiqueta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/formulario_fecha" />

            <EditText
                android:id="@+id/etFecha"
                style="@style/Estilo.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/formulario_fecha_hint"
                android:enabled="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:inputType="text" />

            <TextView
                style="@style/Estilo.Etiqueta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/formulario_nota" />

            <EditText
                android:id="@+id/etNota"
                style="@style/Estilo.Campo"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="8dp"
                android:gravity="top"
                android:paddingTop="12dp"
                android:enabled="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="@string/formulario_nota_hint"
                android:inputType="textMultiLine" />

            <Button
                android:id="@+id/btnGuardar"
                style="@style/Estilo.Boton.Primario"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:text="@string/formulario_guardar" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
