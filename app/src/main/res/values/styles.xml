<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Estilo" >
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/smartcash_texto_principal</item>
    </style>

    <style name="Estilo.Saldo">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/smartcash_texto_principal</item>
    </style>

    <style name="Estilo.Subtitulo">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/smartcash_texto_principal</item>
    </style>

    <style name="Estilo.Etiqueta">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/smartcash_texto_principal</item>
    </style>

    <style name="Estilo.Cuerpo">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/smartcash_texto_principal</item>
    </style>

    <style name="Estilo.Secundario">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/smartcash_texto_secundario</item>
    </style>

    <style name="Estilo.Campo">
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/smartcash_texto_principal</item>
        <item name="android:textColorHint">@color/smartcash_pista</item>
    </style>

    <style name="Estilo.Boton.Primario" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/smartcash_primario</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Estilo.Boton.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/smartcash_primario</item>
        <item name="strokeColor">@color/smartcash_primario</item>
    </style>

    <style name="Estilo.Boton.Peligro" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/smartcash_gasto</item>
        <item name="strokeColor">@color/smartcash_gasto</item>
    </style>
</resources>
